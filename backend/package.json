{
  "name": "reachinbox-backend",
  "version": "0.3.0",
  "description": "ReachInbox SDE Intern Assignment - Backend (Milestone B3: distributed rate limiting, pacing & rescheduling)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/worker.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'),path=require('path');const src=path.join('src','db','migrations'),dest=path.join('dist','db','migrations');if(fs.existsSync(src)){fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dest,f)));}\"",
    "start": "node -r dotenv/config dist/server.js",
    "worker": "node -r dotenv/config dist/worker.js",
    "migrate": "node -r dotenv/config dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integrated": "ts-node -r dotenv/config tests/integrated.e2e.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.1",
    "@bull-board/express": "^6.7.1",
    "@elastic/elasticsearch": "^8.17.0",
    "@types/express-session": "^1.19.0",
    "bullmq": "^5.34.4",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
