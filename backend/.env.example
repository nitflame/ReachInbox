# ---- App ----
NODE_ENV=development
PORT=4000

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
PG_SSL=false

# ---- Redis (used by ioredis + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Ethereal SMTP ----
# Leave SMTP_USER/SMTP_PASS blank in development and the mailer will
# auto-create a throwaway Ethereal test account on worker startup and log
# its credentials + inbox URL. Set real Ethereal creds (https://ethereal.email)
# for stable credentials across restarts, and REQUIRE them in production.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox <no-reply@reachinbox.dev>"

# ---- BullMQ ----
EMAIL_QUEUE_NAME=email-send-queue

# ---- Worker ----
# How many jobs this worker process handles concurrently.
WORKER_CONCURRENCY=5

# ---- Scheduling defaults ----
# DEFAULT_SEND_DELAY_MS is used in two places:
#  1. At /api/emails/schedule time, as the default spacing between a
#     batch's scheduled_at timestamps (when the request omits delayBetweenEmailsMs).
#  2. At send time, as the hard per-sender minimum gap the worker enforces
#     via Redis (services/sendPacing.service.ts) - this is what actually
#     protects against WORKER_CONCURRENCY / multiple worker processes
#     sending too fast, regardless of what was requested at schedule time.
DEFAULT_SEND_DELAY_MS=2000
# DEFAULT_HOURLY_LIMIT seeds a sender's hourly_limit the first time that
# sender is used (see senders table / findOrCreateSender) - the worker's
# rate limiter then enforces that per-sender value, not this env var,
# on every subsequent send. See README "Redis-backed hourly rate limiting".
DEFAULT_HOURLY_LIMIT=100

# ---- Temporary dev auth fallback ----
# Set ENABLE_DEV_AUTH=true to enable dev/test bypass via X-Dev-User-Email header.
# Production ALWAYS uses real session authentication regardless of this setting.
ENABLE_DEV_AUTH=false
DEV_DEFAULT_USER_EMAIL=dev@reachinbox.local

# ---- Slack OAuth & Notifications (B6) ----
# Create Slack App at https://api.slack.com/apps
# Add Redirect URI: http://localhost:4000/api/slack/callback
# Add Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback
SLACK_WEBHOOK_URL=

# ---- Elasticsearch (B4) ----
ELASTICSEARCH_URL=http://localhost:9200

# ---- Google OAuth (B5) ----
# Create OAuth 2.0 Client Credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Add Authorized Redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ---- Session Management (B5) ----
# Cryptographically random string for express-session cookie signing.
# MUST be set explicitly in production (application boot will fail if left default).
SESSION_SECRET=reachinbox-dev-secret-do-not-use-in-production


